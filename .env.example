# Browser-safe OAuth web client ID for the official Google sign-in button.
# Defaults to PracticalTelugu's public Google client ID when omitted.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only key for the optional Practice Live conversation.
# Create one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional consented family voices for Practice Live. Keep these server-only.
FISH_API_KEY=
FISH_GRANDMA_VOICE_ID=
FISH_GRANDPA_VOICE_ID=
# SHA-256 of each lowercase Supabase account email allowed to use private clones.
# Separate multiple owner hashes with commas.
FISH_ALLOWED_EMAIL_SHA256=
# Defaults to Fish Audio's current S2 Pro model when omitted.
FISH_TTS_MODEL=s2-pro
